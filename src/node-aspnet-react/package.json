{
    "name": "@alethic/node-aspnet-react",
    "version": "0.0.0-dev",
    "description": "The JavaScript half of Alethic.Node.AspNet.React: one React tree per Web Forms page, its components placed through portals, and the server render of them on Node embedded in the worker process.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alethic/Alethic.Node.git",
        "directory": "src/node-aspnet-react"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./client": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "jsdom": "^30.1.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
