<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup Label="Native runtime, per platform. The umbrella package pulls every RID at once.">
        <PackageReference Include="Microsoft.JavaScript.LibNode.win-x64" Version="20.1800.215" Condition=" $([MSBuild]::IsOSPlatform('Windows')) " />
        <PackageReference Include="Microsoft.JavaScript.LibNode.linux-x64" Version="20.1800.215" Condition=" $([MSBuild]::IsOSPlatform('Linux')) " />
        <PackageReference Include="Microsoft.JavaScript.LibNode.osx-arm64" Version="20.1800.215" Condition=" $([MSBuild]::IsOSPlatform('OSX')) " />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Alethic.Node\Alethic.Node.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="work.cjs" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
