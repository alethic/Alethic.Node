<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A Web Forms site, as an SDK-style project: the code-behind compiles to bin\, beside the pages, which is all IIS
        needs. Cogito.AspNet.MSBuild writes the binding redirects into Web.config on each build. Running the project,
        with dotnet run or from Visual Studio, serves the site's folder with IIS Express.
    -->

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>Sample.WebForms</RootNamespace>
        <OutputPath>bin\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <IsWebApplicationProject>true</IsWebApplicationProject>
    </PropertyGroup>

    <PropertyGroup Label="Running: IIS Express, 64-bit, as libnode is, on the site's folder.">
        <IISExpressPort Condition=" '$(IISExpressPort)' == '' ">8090</IISExpressPort>
        <RunCommand>$(ProgramW6432)\IIS Express\iisexpress.exe</RunCommand>
        <RunArguments>/path:"$(MSBuildProjectDirectory)" /port:$(IISExpressPort) /clr:v4.0</RunArguments>
        <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System.Configuration" />
        <Reference Include="System.Web" />
        <Reference Include="System.Web.Extensions" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cogito.AspNet.MSBuild" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="Microsoft.JavaScript.LibNode.win-x64" Version="20.1800.203" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Alethic.Node.AspNet.Components\Alethic.Node.AspNet.Components.csproj" />
    </ItemGroup>

    <!--
        The shared client, Sample.Client: its systemweb and systemweb-ssr bundles are this sample's, and its full-page
        application, aspnet and ssr, is mounted on routes of its own.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Sample.Client\Sample.Client.esproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        </ProjectReference>
    </ItemGroup>

    <!--
        Copied into the site's own folder, which is what IIS serves: each browser bundle where it is served, each server
        bundle under App_Data, where nothing is. The full-page application asks for its browser bundle at /app.js.
    -->
    <Target Name="CopyClientBundles" AfterTargets="ResolveProjectReferences">
        <Copy SourceFiles="..\..\Sample.Client\dist\systemweb\client.js" DestinationFolder="components" SkipUnchangedFiles="true" />
        <Copy SourceFiles="..\..\Sample.Client\dist\systemweb-ssr\server.cjs" DestinationFolder="App_Data\components" SkipUnchangedFiles="true" />
        <Copy SourceFiles="..\..\Sample.Client\dist\aspnet\app.js" DestinationFolder="." SkipUnchangedFiles="true" />
        <Copy SourceFiles="..\..\Sample.Client\dist\ssr\app.cjs" DestinationFolder="App_Data\app" SkipUnchangedFiles="true" />
    </Target>

</Project>
